enum Status {
    Open,
    Done(int64),
}

struct Inner {
    count: int64,
}

struct Task {
    id: int64,
    inner: Inner,
}

impl Task {
    fn New(id: int64) -> Task {
        Task { id, inner: Inner { count: 0 } }
    }
    fn Bump(&mut self) {
        self.inner.count += 1
    }
}

fn main() {
    let mut t = Task::New(1);
    let c = t.inner.count;
    t.Bump();
    t.inner.Clear();
    let s = Status::Done(c);
    let o = Status::Open;
    let first = (c, s).0;
}

